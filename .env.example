# Database configuration (SQLite for local dev, Turso/LibSQL Cloud for Vercel production)
# Local: file:./data/sunomaker.db
# Cloud (Turso): libsql://your-db-name.turso.io
DATABASE_URL=file:./data/sunomaker.db
DATABASE_AUTH_TOKEN=

# Cookie & Session encryption (min 32 chars)
SESSION_SECRET=sunomaker-super-secure-session-secret-key-32-chars-min

# Master encryption key for BYOK credentials (AES-256-GCM)
# 32-byte secret (64-char hex or 32+ char string)
KIE_CREDENTIAL_ENCRYPTION_KEY=e4f9b8c2d1e0f3a5b7c9d2e4f6a8b0c2d4e6f8a0b2c4d6e8f0a2b4c6d8e0f2a4

# Application URLs
APP_URL=http://localhost:3000
CALLBACK_URL=http://localhost:3000/api/kie/callback

# Environment mode
NODE_ENV=development

# When true, simulates Kie.ai API calls if no real key or in test environments.
# When false, makes live requests to https://api.kie.ai/api/v1/jobs/createTask using the user's decrypted personal key.
MOCK_KIE_API=false

# CRITICAL RULE:
# DO NOT ADD A GLOBAL KIE_API_KEY HERE!
# SUNOMAKER is strictly Bring-Your-Own-Key (BYOK).
